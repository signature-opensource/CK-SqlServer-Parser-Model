<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Copyright>Copyright 2014-1017 Invenietis</Copyright>
    <Authors>Invenietis</Authors>
    <TargetFrameworks>netstandard1.3;net451</TargetFrameworks>
    <AssemblyName>CK.SqlServer.Parser.Model</AssemblyName>
    <AssemblyOriginatorKeyFile>../SharedKey.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <PackageId>CK.SqlServer.Parser.Model</PackageId>
    <Description>
      Abstractions of T-Sql objects definitions.
    </Description>
    <PackageReleaseNotes>https://bitbucket.org/olivier_spinelli/ck-sqlserver-parser-model</PackageReleaseNotes>
    <PackageLicenseUrl>https://opensource.org/licenses/LGPL-3.0</PackageLicenseUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://bitbucket.org/olivier_spinelli/ck-sqlserver-parser-model</RepositoryUrl>
    <NetStandardImplicitPackageVersion Condition=" '$(TargetFramework)' == 'netstandard1.3' ">1.6.1</NetStandardImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard1.3' ">
    <PackageReference Include="CK.ActivityMonitor.StandardSender" Version="6.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net451' ">
    <PackageReference Include="CK.ActivityMonitor.StandardSender" Version="6.0.0" />
    <Reference Include="System.Data" />
    <Reference Include="System" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
